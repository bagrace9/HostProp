# Optional environment overrides read by the dashboard launcher.
# These are real environment variables, not a file the app parses on its own:
# set them in your shell, service unit, or task scheduler.
# Connection settings, VLAN routing, and credentials are entered in the dashboard
# and stored in APP_CONFIG_PATH.

WEB_HOST=127.0.0.1
WEB_PORT=8088

# Required when WEB_HOST is anything other than localhost/127.0.0.1/::1.
APP_PASSWORD=

APP_CONFIG_PATH=./data/app-config.json
SYNC_STATE_PATH=./data/sync-state.json

# Secrets can stay out of APP_CONFIG_PATH entirely: store "env:NAME" in a secret
# field and the dashboard reads NAME from its own environment when it needs the
# value. NPM_<INSTANCE>_SECRET and PVE_LOCAL_PASSWORD are just a convention.
# NPM_LAB_SECRET=
# PVE_LOCAL_PASSWORD=
