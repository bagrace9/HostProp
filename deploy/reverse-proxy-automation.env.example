# Copy to /etc/default/reverse-proxy-automation and replace the placeholder.
# Keep this file owned by root and readable only by root (mode 0600).
APP_PASSWORD=replace-with-a-long-random-password

# Host names accepted by the dashboard. Localhost and IP-address Host values
# are accepted by default; list DNS names used by a reverse proxy explicitly.
# WEB_ALLOWED_HOSTS=dashboard.example.net

# Optional: use these references in the dashboard's PSL/NPMPlus password fields
# as env:PVE_LOCAL_PASSWORD or env:NPM_LAB_SECRET.
# PVE_LOCAL_PASSWORD=
# NPM_LAB_SECRET=
