[Unit]
Description=Reverse Proxy Automation dashboard and PSL watcher
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=reverse-proxy-automation
Group=reverse-proxy-automation
WorkingDirectory=/opt/reverse-proxy-automation
EnvironmentFile=/etc/default/reverse-proxy-automation
Environment=PYTHONUNBUFFERED=1
UMask=0077
StateDirectory=reverse-proxy-automation
StateDirectoryMode=0700
ExecStart=/opt/reverse-proxy-automation/.venv/bin/python -m reverse_proxy_automation --host 0.0.0.0 --port 8088 --config /var/lib/reverse-proxy-automation/app-config.json --state /var/lib/reverse-proxy-automation/sync-state.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/reverse-proxy-automation
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
